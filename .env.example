TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEET_ID=replace-with-your-google-sheet-id
GOOGLE_WORKSHEET=Records
# Optional: leave blank to let the app create and own its Drive folder automatically
# (required with the drive.file scope, since the app can only see folders it created).
# Set this only if reusing a folder ID the app itself already created on a prior run.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Attendance Records
GOOGLE_DRIVE_OAUTH_CREDENTIALS_FILE=oauth_credentials.json
GOOGLE_DRIVE_OAUTH_TOKEN_FILE=token.json
TESSERACT_CMD=
TIMEZONE=UTC
DRYRUN_STORAGE_DIR=samples
APP_MODE=production
# Canonical "First Middle Last" roster, one name per line -- used to auto-correct
# misspelled employee names pulled from Telegram captions. See employees.txt.
EMPLOYEE_ROSTER_FILE=employees.txt
# Set true to log every OCR attempt (region/variant/psm/raw text/parsed result)
# to OCR_DEBUG_LOG_FILE -- see app/watermark_ocr.py. Turn on when a watermark
# still won't read so the actual per-attempt OCR text can be diagnosed.
OCR_DEBUG=false
OCR_DEBUG_LOG_FILE=ocr_debug.log
# Try PaddleOCR first, fall back to Tesseract (see README "Faster OCR"). Needs
# `pip install paddleocr paddlepaddle`; the bot runs fine without it either way.
FAST_OCR=false